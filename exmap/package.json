{
  "name": "exmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example Map Live - a local-first, voice-driven requirements modeller with human verification",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node bin/exmap.mjs",
    "postinstall": "node scripts/install-stamp.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --server-only",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "npm run build && playwright test",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "zod": "4.6.7",
    "fastify": "5.12.7",
    "@fastify/websocket": "11.3.4",
    "@fastify/static": "10.1.6",
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "@noble/hashes": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vitest": "5.0.5",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.14.0",
    "ws": "8.22.0",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2"
  }
}
