+++ b/packages/nhsuk-frontend/src/nhsuk/components/scroll/scroll.mjs
@@ -0,0 +1,127 @@
+import { normaliseOptions } from '../../common/configuration/index.mjs'
+import { ConfigurableComponent } from '../../configurable-component.mjs'
+import { ElementError } from '../../errors/index.mjs'
+
+/**
+ * Scroll component
+ *
+ * Adds scrollable shadow classes for browsers that do not support the
+ * `scroll-state()` CSS container query, used to hide the shadow when there
+ * is no more content to scroll towards in that direction.
+ *
+ * @augments {ConfigurableComponent<ScrollConfig>}
+ */
+export class Scroll extends ConfigurableComponent {
+  /** @type {HTMLElement} */
+  $content
+
+  /**
+   * @param {Element | null} $root - HTML element to use for component
+   * @param {Partial<ScrollConfig>} [config] - Scroll config
+   */
+  constructor($root, config) {
+    super($root, config)
+
+    const { contentClass } = this.config
+
+    const $content = this.$root.querySelector(`.${contentClass}`)
+    if (!($content instanceof HTMLElement)) {
+      throw new ElementError({
+        component: Scroll,
+        element: $content,
+        identifier: `Scroll content (\`.${contentClass}\`)`
+      })
+    }
+
+    this.$content = $content
+
+    this.handleScroll = this.updateShadows.bind(this)
+    this.$content.addEventListener('scroll', this.handleScroll)
+
+    // ResizeObserver isn't supported by Safari < 13.1 so we need to fall back
+    // to window resize, checking whether the content is now scrollable
+    if ('ResizeObserver' in window) {
+      this.resizeObserver = new window.ResizeObserver(this.handleScroll)
+      this.resizeObserver.observe(this.$content)
+    } else {
+      window.addEventListener('resize', this.handleScroll)
+    }
+
+    this.updateShadows()
+  }
+
+  /**
+   * Update shadow classes to reflect whether content can be scrolled
+   * towards the left and/or right
+   */
+  updateShadows() {
+    const { $content } = this
+    const { scrollLeft, scrollWidth, clientWidth } = $content
+
+    $content.classList.toggle(
+      'nhsuk-scroll__content--scrollable-left',
+      scrollLeft > 0
+    )
+
+    $content.classList.toggle(
+      'nhsuk-scroll__content--scrollable-right',
+      Math.ceil(scrollLeft + clientWidth) < scrollWidth
+    )
+  }
+
+  static moduleName = 'nhsuk-scroll'
+
+  /**
+   * Scroll default config
+   *
+   * @see {@link ScrollConfig}
+   * @constant
+   * @type {ScrollConfig}
+   */
+  static defaults = Object.freeze({
+    contentClass: 'nhsuk-scroll__content'
+  })
+
+  /**
+   * Scroll config schema
+   *
+   * @constant
+   * @satisfies {Schema<ScrollConfig>}
+   */
+  static schema = Object.freeze({
+    properties: {
+      contentClass: { type: 'string' }
+    }
+  })
+}
+
+/**
+ * Initialise scroll component
+ *
+ * @deprecated Use {@link createAll | `createAll(Scroll, options)`} instead.
+ * @param {InitOptions & Partial<ScrollConfig>} [options]
+ */
+export function initScroll(options) {
+  const { scope: $scope } = normaliseOptions(options)
+
+  const $scrolls = $scope?.querySelectorAll(
+    `[data-module="${Scroll.moduleName}"]`
+  )
+
+  $scrolls?.forEach(($root) => {
+    new Scroll($root, options)
+  })
+}
+
+/**
+ * Scroll config
+ *
+ * @see {@link Scroll.defaults}
+ * @typedef {object} ScrollConfig
+ * @property {string} contentClass - Scroll content class for scrollable element
+ */
+
+/**
+ * @import { Schema } from '../../common/configuration/index.mjs'
+ * @import { createAll, InitOptions } from '../../index.mjs'
+ */
