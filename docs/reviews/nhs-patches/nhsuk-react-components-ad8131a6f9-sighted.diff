+import classNames from 'classnames';
+import { forwardRef, type ComponentPropsWithoutRef } from 'react';
+
+export interface PaginationLinkTextProps extends ComponentPropsWithoutRef<'span'> {
+  previous?: boolean;
+  next?: boolean;
+}
+
+export const PaginationLinkText = forwardRef<HTMLSpanElement, PaginationLinkTextProps>(
+  ({ className, children, previous, next, ...rest }, forwardedRef) => (
+    <span
+      className={classNames('nhsuk-pagination__title', className)}
+      ref={forwardedRef}
+      {...rest}
+    >
+      {children || (previous ? 'Previous' : null) || (next ? 'Next' : null)}
+      {!children ? <span className="nhsuk-u-visually-hidden"> page</span> : null}
+    </span>
+  ),
+);
+
+PaginationLinkText.displayName = 'Pagination.LinkText';
