+import classNames from 'classnames';
+import { forwardRef } from 'react';
+import { ArrowLeftIcon, ArrowRightIcon } from '#components/content-presentation/index.js';
+import { type AsElementLink } from '#util/types/index.js';
+import { PaginationLinkText } from './PaginationLinkText.js';
+
+export interface PaginationItemProps extends Partial<AsElementLink<HTMLAnchorElement>> {
+  previous?: boolean;
+  next?: boolean;
+  labelText?: string;
+  number?: number;
+  current?: boolean;
+  ellipsis?: boolean;
+}
+
+export const PaginationItem = forwardRef<HTMLAnchorElement, PaginationItemProps>(
+  (
+    {
+      className,
+      children,
+      asElement: Element = 'a',
+      previous,
+      next,
+      labelText,
+      number,
+      current,
+      ellipsis,
+      ...rest
+    },
+    forwardedRef,
+  ) => {
+    if (ellipsis) {
+      return <li className="nhsuk-pagination__item nhsuk-pagination__item--ellipsis">⋯</li>;
+    }
+
+    if (number != null) {
+      return (
+        <li
+          className={classNames('nhsuk-pagination__item', {
+            'nhsuk-pagination__item--current': current,
+          })}
+        >
+          <Element
+            className={classNames('nhsuk-pagination__link', className)}
+            aria-label={`Page ${number}`}
+            ref={forwardedRef}
+            {...rest}
+          >
+            {number}
+          </Element>
+        </li>
+      );
+    }
+
+    return (
+      <li
+        className={classNames(
+          { 'nhsuk-pagination-item--previous': previous },
+          { 'nhsuk-pagination-item--next': next },
+        )}
+      >
+        <Element
+          className={classNames(
+            'nhsuk-pagination__link',
+            { 'nhsuk-pagination__link--prev': previous },
+            { 'nhsuk-pagination__link--next': next },
+            className,
+          )}
+          rel={previous ? 'prev' : 'next'}
+          ref={forwardedRef}
+          {...rest}
+        >
+          <PaginationLinkText previous={previous} next={next}>
+            {children}
+          </PaginationLinkText>
+          {labelText ? (
+            <>
+              <span className="nhsuk-u-visually-hidden">:</span>
+              <span className="nhsuk-pagination__page">{labelText}</span>
+            </>
+          ) : null}
+          {previous ? <ArrowLeftIcon /> : null}
+          {next ? <ArrowRightIcon /> : null}
+        </Element>
+      </li>
+    );
+  },
+);
+
+PaginationItem.displayName = 'Pagination.Item';
