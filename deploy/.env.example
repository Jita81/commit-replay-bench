# Commit Replay Bench — compose environment. Copy to deploy/.env (chmod 0600) and fill in.
# deploy/.env is git-ignored (deploy/.gitignore). Never commit a filled-in copy.
#
# Generate secrets with:  openssl rand -hex 32
# Use URL-safe values (hex/alphanumeric) for POSTGRES_PASSWORD — it is embedded in a URL.

# --- required -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
CRB_SECRET_KEY=
# The image to run (build locally with `docker compose build`, or pull a release tag).
CRB_IMAGE=crb:local

# --- server -------------------------------------------------------------------------------
CRB_ENV=prod
# Host address:port the API is published on. Keep 127.0.0.1 and terminate TLS in a reverse
# proxy on the same host (deploy/README.md §2). Set CRB_BIND_ADDR=0.0.0.0 only behind a
# firewall you control.
CRB_BIND_ADDR=127.0.0.1
CRB_PORT=8000
# Proxy addresses whose X-Forwarded-For/-Proto headers uvicorn trusts (comma separated).
CRB_FORWARDED_ALLOW_IPS=127.0.0.1
CRB_WEB_CONCURRENCY=2
# Browser origins allowed to call the API (only needed if the UI is served elsewhere).
CRB_CORS_ORIGINS=
# Host directory bind-mounted at /srv/crb in api and worker (evidence, clones, worktrees).
# Must be owned by uid 10001. MUST be the same absolute path on the host as in the container
# because the worker's sandbox bind-mounts are resolved by the host daemon.
CRB_HOST_DIR=/srv/crb

# --- first admin (honoured only while the users table is empty) -------------------------
CRB_BOOTSTRAP_ADMIN__USERNAME=admin
CRB_BOOTSTRAP_ADMIN__PASSWORD=
# Set to false once OIDC works to disable local password login entirely.
CRB_LOCAL_AUTH_ENABLED=true

# --- OIDC (Microsoft Entra ID or any OpenID Connect issuer) — leave empty to disable ------
# Entra ID: issuer = https://login.microsoftonline.com/<tenant-id>/v2.0
CRB_OIDC__ISSUER=
CRB_OIDC__CLIENT_ID=
CRB_OIDC__CLIENT_SECRET=
CRB_OIDC__REDIRECT_URL=https://crb.example.internal/auth/callback
CRB_OIDC__SCOPES=openid profile email
# Claim carrying roles/groups, and the mapping claim-value → crb role (viewer|operator|approver|admin)
CRB_OIDC__ROLE_CLAIM=roles
CRB_OIDC__ROLE_MAP={"crb.viewer": "viewer", "crb.operator": "operator", "crb.approver": "approver", "crb.admin": "admin"}
CRB_OIDC__ADMIN_GROUPS=

# --- model endpoint (BYOK; the ONLY permitted egress from the worker) ---------------------
# OpenAI-compatible endpoint (self-hosted vLLM, Cerebras, …):
CRB_OPENAI_BASE_URL=
CRB_OPENAI_KEY_ENV=CEREBRAS_API_KEY
CEREBRAS_API_KEY=
# …OR Azure OpenAI in your own tenant (private endpoint). Setting CRB_AZURE_ENDPOINT selects
# Azure; the key is read from the variable named by CRB_AZURE_KEY_ENV.
CRB_AZURE_ENDPOINT=
CRB_AZURE_DEPLOYMENT=
CRB_AZURE_API_VERSION=2024-10-21
CRB_AZURE_KEY_ENV=AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
# Claude Code builder (optional)
ANTHROPIC_API_KEY=

# --- worker / sandbox ---------------------------------------------------------------------
# docker (default; fail-closed without the socket opt-in in docker-compose.yml) | local (dev only)
CRB_SANDBOX__EXECUTOR=docker
# Default sandbox image when a repository config does not name one.
CRB_SANDBOX__IMAGE=
CRB_WORKER_ID=worker-1
# gid of /var/run/docker.sock on the host (`stat -c %g /var/run/docker.sock`); used only if
# you enable the socket mount + group_add in docker-compose.yml.
DOCKER_GID=999

# --- retention ----------------------------------------------------------------------------
# Days to keep builder transcripts referenced from evidence packs. 0 = keep none.
CRB_RETENTION__TRANSCRIPTS_DAYS=0
