# Commit Replay Bench — compose environment. Copy to deploy/.env (chmod 0600) and fill in.
# deploy/.env is git-ignored (deploy/.gitignore). Never commit a filled-in copy.
#
# Generate secrets with:  openssl rand -hex 32
# Use URL-safe values (hex/alphanumeric) for POSTGRES_PASSWORD — it is embedded in a URL.

# --- required -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
CRB_SECRET_KEY=
# The image to run (build locally with `docker compose build`, or pull a release tag).
CRB_IMAGE=crb:local

# --- server -------------------------------------------------------------------------------
CRB_ENV=prod
# Host address:port the API is published on. Keep 127.0.0.1 and terminate TLS in a reverse
# proxy on the same host (deploy/README.md §2). Set CRB_BIND_ADDR=0.0.0.0 only behind a
# firewall you control.
CRB_BIND_ADDR=127.0.0.1
CRB_PORT=8000
# Proxy addresses whose X-Forwarded-For/-Proto headers uvicorn trusts (comma separated).
CRB_FORWARDED_ALLOW_IPS=127.0.0.1
CRB_WEB_CONCURRENCY=2
# Browser origins allowed to call the API (only needed if the UI is served elsewhere).
CRB_CORS_ORIGINS=
# Host directory bind-mounted at /srv/crb in api and worker (evidence, clones, worktrees).
# Must be owned by uid 10001. MUST be the same absolute path on the host as in the container
# because the worker's sandbox bind-mounts are resolved by the host daemon.
CRB_HOST_DIR=/srv/crb

# --- first admin (honoured only while the users table is empty) -------------------------
CRB_BOOTSTRAP_ADMIN__USERNAME=admin
CRB_BOOTSTRAP_ADMIN__PASSWORD=
# Set to false once OIDC works to disable local password login entirely.
CRB_LOCAL_AUTH_ENABLED=true

# --- OIDC (Microsoft Entra ID or any OpenID Connect issuer) — leave empty to disable ------
# Entra ID: issuer = https://login.microsoftonline.com/<tenant-id>/v2.0
CRB_OIDC__ISSUER=
CRB_OIDC__CLIENT_ID=
CRB_OIDC__CLIENT_SECRET=
CRB_OIDC__REDIRECT_URL=https://crb.example.internal/auth/callback
CRB_OIDC__SCOPES=openid profile email
# Claim carrying roles/groups, and the mapping claim-value → crb role (viewer|operator|approver|admin)
CRB_OIDC__ROLE_CLAIM=roles
CRB_OIDC__ROLE_MAP={"crb.viewer": "viewer", "crb.operator": "operator", "crb.approver": "approver", "crb.admin": "admin"}
CRB_OIDC__ADMIN_GROUPS=

# --- model endpoint (BYOK; the ONLY permitted egress from the worker) ---------------------
# OpenAI-compatible endpoint (self-hosted vLLM, Cerebras, …):
CRB_OPENAI_BASE_URL=
CRB_OPENAI_KEY_ENV=CEREBRAS_API_KEY
CEREBRAS_API_KEY=
# …OR Azure OpenAI in your own tenant (private endpoint). Setting CRB_AZURE_ENDPOINT selects
# Azure; the key is read from the variable named by CRB_AZURE_KEY_ENV.
CRB_AZURE_ENDPOINT=
CRB_AZURE_DEPLOYMENT=
CRB_AZURE_API_VERSION=2024-10-21
CRB_AZURE_KEY_ENV=AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
# Claude Code builder (optional)
ANTHROPIC_API_KEY=

# --- worker / sandbox ---------------------------------------------------------------------
# docker (default; fail-closed without the socket opt-in in docker-compose.yml) | local (dev only)
CRB_SANDBOX__EXECUTOR=docker
# Each repository names its own sandbox image (its sandbox_image). A docker run whose
# repository names none is refused (`sandbox_image_missing`, ADR-0061) unless
# CRB_SANDBOX__ALLOW_DEFAULT_IMAGE=1 lets it use CRB_SANDBOX__IMAGE (off by default; each run
# that does records a `run.sandbox_default_image` event). Start from the shipped reference
# images — deploy/sandbox/README.md:
#   docker build -f deploy/sandbox/Dockerfile.python -t crb-sandbox-python:local deploy/sandbox
# The worker never pulls: the image must be in the host daemon's store.
CRB_SANDBOX__IMAGE=
CRB_SANDBOX__ALLOW_DEFAULT_IMAGE=0
# Where the builder runs: empty = the env's default (docker in prod: the sealed container of
# ADR-0012; host in dev). Compose hands this one value to the api and the worker, so /health
# describes the builds the worker actually runs. Production refuses
# `host` — and CRB_SANDBOX__EXECUTOR=local — unless CRB_ALLOW_UNSEALED_PROD=1 is set with
# CRB_ALLOW_UNSEALED_PROD_BY and CRB_ALLOW_UNSEALED_PROD_REASON (below; ADR-0023): the
# override is shown on /health and the Posture page and stamped into every run's apparatus, and
# what such a run measures is a development reading, not evidence. Factory builds always run
# on the host, so in prod a factory run is refused unless that override is set.
CRB_BUILDER__EXECUTOR=
# The builder images (deploy/Dockerfile.builder), in the daemon's store, chosen per run from
# the language of the run's repository (ADR-0061): CRB_BUILDER__IMAGE_<LANG> when set, else
# CRB_BUILDER__IMAGE for the languages CRB_BUILDER__IMAGE_LANGUAGES lists (e.g. `python`).
# A run whose language has no image is refused before any model call (`builder_image_missing`,
# naming the variable to set), never built in another language's image or on the host.
CRB_BUILDER__IMAGE=
CRB_BUILDER__IMAGE_LANGUAGES=
CRB_BUILDER__IMAGE_PYTHON=
CRB_BUILDER__IMAGE_GO=
CRB_BUILDER__IMAGE_JAVASCRIPT=
# The egress sidecar runs python3 from this image; empty, it uses CRB_BUILDER__IMAGE, else the
# run's own builder image. The Go and Node builder images carry no python3: a deployment that
# serves them with no CRB_BUILDER__IMAGE names an image with python3 here (deploy/README §9.1).
CRB_BUILDER__PROXY_IMAGE=
# CRB_ALLOW_UNSEALED_PROD=1
# In prod the override must name the admin who set it and why; each start of the api and the
# worker writes an audit event naming them, and refuses to start if the name is not an
# active admin (ADR-0023 as amended; docs/DEPLOYMENT.md §2.1).
# CRB_ALLOW_UNSEALED_PROD_BY=<an admin's username>
# CRB_ALLOW_UNSEALED_PROD_REASON=<why, in their words>
CRB_WORKER_ID=worker-1
# The repository languages this worker claims runs for (comma list; empty = every language).
# Run one worker per toolchain by giving each its own value (ADR-0061).
CRB_WORKER_LANGUAGES=
# gid of /var/run/docker.sock on the host (`stat -c %g /var/run/docker.sock`); used only if
# you enable the socket mount + group_add in docker-compose.yml.
DOCKER_GID=999

# --- factory -------------------------------------------------------------------------------
# The rung that writes the failing test for an item nobody authored one for:
# builder:model[:provider], the same spelling as a build rung. Empty (or `none`) = no author,
# and such an item stops `no_oracle`. The author rung and the build rung are never the same
# rung: a label that is also on a run's ladder is refused before anything is built.
CRB_FACTORY__TEST_AUTHOR=

# --- retention ----------------------------------------------------------------------------
# Days to keep builder transcripts referenced from evidence packs. 0 = keep none.
CRB_RETENTION__TRANSCRIPTS_DAYS=0
