# syntax=docker/dockerfile:1.7
#
# Commit Replay Bench (crb) — reference SANDBOX image: Node.js (`node --test` runner).
#
# What runs in it: a repository's tests, one `docker run` per test command, driven by
# `crb.core.execution.DockerExecutor` (the grader's probe / qualify / grade path). It is NOT
# the product image (deploy/Dockerfile) and NOT the builder image (deploy/Dockerfile.builder).
#
# What it contains — the toolchain and the test runner the `node` runner invokes, nothing
# else: Node.js 22 (its built-in test runner and JUnit reporter) and the npm the base image
# ships, which a derived image uses to install a repository's devDependencies. No git, no
# compiler, nothing that listens. The vitest / jest / mocha runners resolve their binary
# from the repository's own `node_modules` (visible through the read-only worktree mount
# when a host setup installed it) — a repository that needs them extends this image with
# an `npm ci` of its lockfile: deploy/sandbox/README.md §4.
#
# Build from deploy/sandbox:
#
#     docker build -f deploy/sandbox/Dockerfile.node -t crb-sandbox-node:local deploy/sandbox
#
# then select it per repository (`sandbox_image` on the RepoConfig) or as the deployment
# default: CRB_SANDBOX__IMAGE=crb-sandbox-node:local (Helm: config.CRB_SANDBOX__IMAGE).
# The worker never pulls: the image must be present in the host daemon's store.
#
# How the worker runs it (crb.core.execution.DockerExecutor.build_argv — asserted flag by
# flag in tests/test_execution.py; proven from inside against a daemon in
# tests/test_sandbox_images_docker.py):
#
#     docker run --rm --network=none --memory=2g --cpus=2 --pids-limit=512
#       --user=65534:65534 --cap-drop=ALL --security-opt no-new-privileges --read-only
#       --tmpfs /tmp:rw,nosuid,nodev,size=512m
#       --mount type=bind,src=<worktree>,dst=/work,readonly
#       --env NODE_PATH=/work/node_modules --env NODE_ENV=test
#       --env HOME=/tmp --env CI=1 --env NO_COLOR=1 --workdir /work
#       crb-sandbox-node:local node --test --test-reporter=junit --test-reporter-destination=stdout …
#
# Security posture (docs/SECURITY.md §3.1):
#   * The base is pinned BY DIGEST (the multi-arch index, so amd64 and arm64 resolve the same
#     bytes); a rebuild without editing the FROM line reproduces the same base. Re-pin by
#     editing the line — deploy/sandbox/README.md §5 has the cadence.
#   * Runs as uid 65534 (nobody) by default — not the base image's `node` user (uid 1000);
#     the worker passes --user=65534:65534 as well, and DockerSettings refuses root.
#   * Works with a read-only root: Node writes nothing outside HOME=/tmp (the tmpfs the
#     executor provides); npm's update check and its cache are pointed there and disabled.
#   * Nothing secret is baked in; nothing listens; no package-manager invocation at all.

FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

LABEL org.opencontainers.image.title="Commit Replay Bench sandbox: node" \
      org.opencontainers.image.description="Reference test sandbox: Node.js 22 + node --test, uid 65534, read-only-root compatible" \
      org.opencontainers.image.vendor="Automated Agile" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Jita81/commit-replay-bench" \
      org.opencontainers.image.documentation="https://github.com/Jita81/commit-replay-bench/blob/main/deploy/sandbox/README.md"

ENV HOME=/tmp \
    NODE_ENV=test \
    NO_UPDATE_NOTIFIER=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

# /work is the worktree mount point; the base's own probe proves the runtime is whole.
RUN set -eu; \
    mkdir -p /work; chmod 0755 /work; \
    node --version; npm --version

WORKDIR /work
USER 65534:65534
ENTRYPOINT []
CMD ["node", "--version"]
